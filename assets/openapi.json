  "components": {
    "schemas": {
      "AddBloodUnitDto": {
        "required": [
          "donorId",
          "componentType",
          "bloodType",
          "volumeMl",
          "collectionDate",
          "expirationDate"
        ],
        "type": "object",
        "properties": {
          "donorId": {
            "type": "string",
            "format": "uuid"
          },
          "componentType": {
            "type": "string"
          },
          "bloodType": {
            "type": "string"
          },
          "volumeMl": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "collectionDate": {
            "type": "string",
            "format": "date-time"
          },
          "expirationDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthResponse": {
        "required": [
          "token",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UserResponseDto"
              }
            ]
          },
          "refreshToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "BloodInventoryRecordDto": {
        "required": [
          "bloodType",
          "componentType",
          "availableCount",
          "quarantinedCount",
          "expiredCount"
        ],
        "type": "object",
        "properties": {
          "bloodType": {
            "type": "string"
          },
          "componentType": {
            "type": "string"
          },
          "availableCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "quarantinedCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "expiredCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "BloodRequestDto": {
        "required": [
          "bloodBankId",
          "bloodType",
          "componentType",
          "numberOfUnits",
          "urgencyLevel",
          "notes"
        ],
        "type": "object",
        "properties": {
          "bloodBankId": {
            "type": "string",
            "format": "uuid"
          },
          "bloodType": {
            "$ref": "#/components/schemas/BloodType"
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "numberOfUnits": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "urgencyLevel": {
            "$ref": "#/components/schemas/UrgencyLevel"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "BloodType": {
        "type": "integer"
      },
      "BookDonationAppointmentDto": {
        "required": [
          "bloodBankId",
          "appointmentDate"
        ],
        "type": "object",
        "properties": {
          "bloodBankId": {
            "type": "string",
            "format": "uuid"
          },
          "appointmentDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ComponentType": {
        "type": "integer"
      },
      "Gender": {
        "type": "integer"
      },
      "InventorySummaryDto": {
        "required": [
          "bloodBankId",
          "bloodBankName",
          "totalUnits",
          "totalAvailableUnits",
          "totalQuarantinedUnits",
          "totalExpiredUnits",
          "breakdown"
        ],
        "type": "object",
        "properties": {
          "bloodBankId": {
            "type": "string",
            "format": "uuid"
          },
          "bloodBankName": {
            "type": "string"
          },
          "totalUnits": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalAvailableUnits": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalQuarantinedUnits": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalExpiredUnits": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "breakdown": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BloodInventoryRecordDto"
            }
          }
        }
      },
      "LoginUserDto": {
        "required": [
          "nationalID",
          "password"
        ],
        "type": "object",
        "properties": {
          "nationalID": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RecordBloodTestDto": {
        "required": [
          "bloodUnitId",
          "testType",
          "isPassed",
          "notes"
        ],
        "type": "object",
        "properties": {
          "bloodUnitId": {
            "type": "string",
            "format": "uuid"
          },
          "testType": {
            "type": "string"
          },
          "isPassed": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "RegisterUserDto": {
        "required": [
          "firstName",
          "lastName",
          "gender",
          "nationalID",
          "email",
          "phone",
          "date",
          "password",
          "passwordConfirm"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "nationalID": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "password": {
            "type": "string"
          },
          "passwordConfirm": {
            "type": "string"
          }
        }
      },
      "TransferBloodUnitsDto": {
        "required": [
          "recipientUserId",
          "unitsCount",
          "reason"
        ],
        "type": "object",
        "properties": {
          "recipientUserId": {
            "type": "string",
            "format": "uuid"
          },
          "unitsCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "UrgencyLevel": {
        "type": "integer"
      },
      "UserCreditResponseDto": {
        "required": [
          "credit"
        ],
        "type": "object",
        "properties": {
          "credit": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "UserResponseDto": {
        "required": [
          "id",
          "fullName",
          "email",
          "phoneNumber",
          "bloodType",
          "bloodUnitsBalance"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "bloodType": {
            "$ref": "#/components/schemas/BloodType"
          },
          "bloodUnitsBalance": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "VisitResponse": {
        "required": [
          "id",
          "visitDate",
          "visitType",
          "visitLocation",
          "visitStatus"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "visitDate": {
            "type": "string",
            "format": "date-time"
          },
          "visitType": {
            "type": "string"
          },
          "visitLocation": {
            "type": "string"
          },
          "visitStatus": {
            "type": "string"
          }
        }
